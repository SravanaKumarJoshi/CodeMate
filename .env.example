# ==============================================================================
# CodeMate Enterprise Environment Configuration
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=False

# LLM Configuration (OpenAI or any OpenAI-compatible provider)
# If left empty, CodeMate runs in zero-config offline mode with grounded responses!
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small

# Server & Database Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./data/codemate.db
JWT_SECRET_KEY=codemate-enterprise-secret-jwt-key-38472910
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Large Repository Ingestion Limits
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_KB=64
MAX_EXTRACTED_SIZE_MB=5120
MAX_ARCHIVE_FILES=100000
MAX_FILE_SIZE_MB=50

# ChromaDB & Vector Store
CHROMA_COLLECTION_NAME=codemate_chunks
TOP_K_RESULTS=5
CHUNK_SIZE=400
CHUNK_OVERLAP=60
EMBEDDING_BATCH_SIZE=64

# Agent Cognitive Limits (Guardrails)
MAX_AGENT_ITERATIONS=4
MAX_TOOL_CALLS=6
MAX_RETRIEVED_CHUNKS=8
MAX_CONTEXT_TOKENS=4000
